@using Lombiq.Hosting.BuildVersionDisplay.Models
@{
    var buildVersionModel = new BuildVersionModel();
}

<div id="lombiq-hosting-build-version-display-build-version">
    @T["Build versions:"]
    <ul>
        <li>
            @T["Orchard Core version: {0}", buildVersionModel.OrchardVersion]
        </li>
        <li>
            @T["App build version: {0}", buildVersionModel.BuildVersion]
        </li>
        @if (!string.IsNullOrEmpty(buildVersionModel.BuildUrl))
        {
            <li>
                @T["<a href=\"{0}\" target=\"_blank\">Build link</a>", buildVersionModel.BuildUrl]
            </li>
        }
    </ul>
</div>
